<?xml version="1.0" encoding="utf-8"?>
<robot name="amazinghand" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    hand.urdf.xacro - full hand assembly.

    Arguments:
      hand_name   : "right_hand" | "left_hand"
      serial_port : e.g. "/dev/ttyUSB0"
      use_sim     : "true" uses gz_ros2_control, "false" uses real hardware plugin
      gazebo_controllers : optional Gazebo controller configuration file
      show_covers        : include shell visuals when "true"

    Finger geometry and joint poses come from the left and right CAD data.
  -->

  <xacro:arg name="hand_name"   default="right_hand"/>
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="use_sim"     default="false"/>
  <xacro:arg name="gazebo_controllers" default=""/>
  <xacro:arg name="show_covers" default="true"/>
  <xacro:include filename="finger.xacro"/>

  <xacro:property name="hand" value="$(arg hand_name)"/>
  <xacro:property name="chirality" value="${hand.split('_')[0]}"/>
  <xacro:property name="hand_data" value="${xacro.load_yaml('../config/' + hand + '.yaml')}"/>
  <xacro:property name="covers" value="$(arg show_covers)"/>

  <xacro:amazinghand_link name="${hand}_palm_link" link_data="${hand_data.palm}" covers="${covers}"/>

  <xacro:amazinghand_finger
    hand_name="$(arg hand_name)"
    finger_name="index"
    chirality="${chirality}"
    parent="$(arg hand_name)_palm_link"
    finger_data="${hand_data.fingers.index}"
    covers="${covers}"/>

  <xacro:amazinghand_finger
    hand_name="$(arg hand_name)"
    finger_name="middle"
    chirality="${chirality}"
    parent="$(arg hand_name)_palm_link"
    finger_data="${hand_data.fingers.middle}"
    covers="${covers}"/>

  <xacro:amazinghand_finger
    hand_name="$(arg hand_name)"
    finger_name="ring"
    chirality="${chirality}"
    parent="$(arg hand_name)_palm_link"
    finger_data="${hand_data.fingers.ring}"
    covers="${covers}"/>

  <xacro:amazinghand_finger
    hand_name="$(arg hand_name)"
    finger_name="thumb"
    chirality="${chirality}"
    parent="$(arg hand_name)_palm_link"
    finger_data="${hand_data.fingers.thumb}"
    covers="${covers}"/>

  <xacro:if value="$(arg use_sim)">
    <link name="world"/>
    <joint name="${hand}_world_joint" type="fixed">
      <parent link="world"/>
      <child link="${hand}_palm_link"/>
      <origin xyz="0 0 0.2"/>
    </joint>
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <xacro:if value="${xacro.arg('gazebo_controllers') != ''}">
          <parameters>$(arg gazebo_controllers)</parameters>
        </xacro:if>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- ros2_control hardware block                                             -->
  <!-- Finger parameters are passed as <param> tags so the hardware interface -->
  <!-- can reconstruct FingerConfig objects without a separate YAML read.      -->
  <ros2_control name="$(arg hand_name)" type="system">

    <xacro:if value="$(arg use_sim)">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
    </xacro:if>
    <xacro:unless value="$(arg use_sim)">
      <hardware>
        <plugin>amazinghand_hardware/AmazingHandHardwareInterface</plugin>
        <param name="hand_name">$(arg hand_name)</param>
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baud_rate">1000000</param>
        <param name="servo_min_pos">200</param>
        <param name="servo_max_pos">824</param>
        <!-- Finger 0: index -->
        <param name="finger.0.name">index</param>
        <param name="finger.0.chirality">${chirality}</param>
        <param name="finger.0.leader_id">1</param>
        <param name="finger.0.follower_id">2</param>
        <!-- Finger 1: middle -->
        <param name="finger.1.name">middle</param>
        <param name="finger.1.chirality">${chirality}</param>
        <param name="finger.1.leader_id">3</param>
        <param name="finger.1.follower_id">4</param>
        <!-- Finger 2: ring -->
        <param name="finger.2.name">ring</param>
        <param name="finger.2.chirality">${chirality}</param>
        <param name="finger.2.leader_id">5</param>
        <param name="finger.2.follower_id">6</param>
        <!-- Finger 3: thumb -->
        <param name="finger.3.name">thumb</param>
        <param name="finger.3.chirality">${chirality}</param>
        <param name="finger.3.leader_id">7</param>
        <param name="finger.3.follower_id">8</param>
      </hardware>
    </xacro:unless>

    <!-- Semantic joints. One flexion + one abduction per finger -->
    <!-- Index -->
    <joint name="$(arg hand_name)_index_flexion">
      <command_interface name="position">
        <param name="min">-1.5708</param><param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="$(arg hand_name)_index_abduction">
      <command_interface name="position">
        <param name="min">-0.5236</param><param name="max">0.5236</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <xacro:amazinghand_passive_joints name="${hand}_index" use_sim="$(arg use_sim)"/>

    <!-- Middle -->
    <joint name="$(arg hand_name)_middle_flexion">
      <command_interface name="position">
        <param name="min">-1.5708</param><param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="$(arg hand_name)_middle_abduction">
      <command_interface name="position">
        <param name="min">-0.5236</param><param name="max">0.5236</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <xacro:amazinghand_passive_joints name="${hand}_middle" use_sim="$(arg use_sim)"/>

    <!-- Ring -->
    <joint name="$(arg hand_name)_ring_flexion">
      <command_interface name="position">
        <param name="min">-1.5708</param><param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="$(arg hand_name)_ring_abduction">
      <command_interface name="position">
        <param name="min">-0.5236</param><param name="max">0.5236</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <xacro:amazinghand_passive_joints name="${hand}_ring" use_sim="$(arg use_sim)"/>

    <!-- Thumb -->
    <joint name="$(arg hand_name)_thumb_flexion">
      <command_interface name="position">
        <param name="min">-1.5708</param><param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="$(arg hand_name)_thumb_abduction">
      <command_interface name="position">
        <param name="min">-0.5236</param><param name="max">0.5236</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <xacro:amazinghand_passive_joints name="${hand}_thumb" use_sim="$(arg use_sim)"/>

  </ros2_control>

</robot>
